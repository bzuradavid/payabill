generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PAID
  REJECTED
  VOID
}

enum PaymentMethod {
  ACH
  CHECK
  WIRE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GLAccountType {
  EXPENSE
  LIABILITY
  ASSET
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vendor {
  id                   String        @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  zip                  String?
  country              String        @default("US")
  defaultPaymentMethod PaymentMethod @default(ACH)
  bankName             String?
  bankRoutingNumber    String?
  bankAccountNumber    String?
  taxId                String?
  status               VendorStatus  @default(ACTIVE)
  bills                Bill[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([name])
  @@index([status])
}

model GLAccount {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  type      GLAccountType
  lineItems BillLineItem[]
  createdAt DateTime       @default(now())

  @@index([type])
}

model Bill {
  id              String         @id @default(cuid())
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  vendorId        String
  invoiceNumber   String?
  invoiceDate     DateTime
  dueDate         DateTime
  status          BillStatus     @default(DRAFT)
  memo            String?
  paymentMethod   PaymentMethod?
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  lineItems       BillLineItem[]
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([dueDate])
}

model BillLineItem {
  id          String     @id @default(cuid())
  bill        Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId      String
  description String
  quantity    Float      @default(1)
  unitPrice   Float
  amount      Float
  glAccount   GLAccount? @relation(fields: [glAccountId], references: [id])
  glAccountId String?
  createdAt   DateTime   @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  bill          Bill          @relation(fields: [billId], references: [id])
  billId        String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?
  scheduledDate DateTime?
  processedDate DateTime?
  memo          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
