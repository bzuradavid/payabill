generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PAID
  REJECTED
  VOID
}

enum PaymentMethod {
  ACH
  CHECK
  WIRE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GLAccountType {
  EXPENSE
  LIABILITY
  ASSET
}

model Vendor {
  id                   String        @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  zip                  String?
  country              String        @default("US")
  defaultPaymentMethod PaymentMethod @default(ACH)
  bankName             String?
  bankRoutingNumber    String?
  bankAccountNumber    String?
  taxId                String?
  status               VendorStatus  @default(ACTIVE)
  bills                Bill[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([name])
  @@index([status])
}

model GLAccount {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  type      GLAccountType
  lineItems BillLineItem[]
  createdAt DateTime       @default(now())

  @@index([type])
}

model Bill {
  id              String         @id @default(cuid())
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  vendorId        String
  invoiceNumber   String?
  invoiceDate     DateTime
  dueDate         DateTime
  status          BillStatus     @default(DRAFT)
  memo            String?
  paymentMethod   PaymentMethod?
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  lineItems       BillLineItem[]
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([dueDate])
}

model BillLineItem {
  id          String     @id @default(cuid())
  bill        Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId      String
  description String
  quantity    Float      @default(1)
  unitPrice   Float
  amount      Float
  glAccount   GLAccount? @relation(fields: [glAccountId], references: [id])
  glAccountId String?
  createdAt   DateTime   @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  bill          Bill          @relation(fields: [billId], references: [id])
  billId        String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?
  scheduledDate DateTime?
  processedDate DateTime?
  memo          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
